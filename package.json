    "@upstash/redis": "^1.38.4",
    "bcryptjs": "^3.0.3",
    "jose": "^6.1.3",
    "next": "^16.3.5",
    "next-themes": "^0.2.1",
    "prisma": "^6.19.3",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-icons": "^5.0.1",
    "react-markdown": "^9.0.1",
    "rehype-highlight": "^7.0.1",
    "remark-gfm": "^4.0.0"
