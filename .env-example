# 런타임용. DDL 권한이 없는 앱 전용 롤(beenslab_app)로 붙는다.
DATABASE_URL=""

# 마이그레이션 전용. 테이블 소유자(postgres)가 필요하다. 로컬에서만 쓰고
# Vercel에는 넣지 않는다(운영에서 마이그레이션을 돌리지 않는다).
DIRECT_URL=""

# Upstash for Redis (visitor counter), injected by the Vercel Marketplace integration
KV_REST_API_URL="https://your-db.upstash.io"
KV_REST_API_TOKEN="your-kv-rest-token"

JWT_SECRET="your-jwt-secret-key"

# Vercel Cron이 조회수 동기화 라우트를 부를 때 쓰는 비밀값.
# 설정돼 있으면 Vercel이 Authorization: Bearer <값>을 자동으로 붙여준다.
# 없으면 라우트가 503으로 거부한다(공개 상태로 두지 않기 위해).
CRON_SECRET=""
