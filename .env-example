DATABASE_URL=""

# Upstash for Redis (visitor counter), injected by the Vercel Marketplace integration
KV_REST_API_URL="https://your-db.upstash.io"
KV_REST_API_TOKEN="your-kv-rest-token"

JWT_SECRET="your-jwt-secret-key"

# giscus(GitHub Discussions) 댓글. 네 개가 모두 있어야 댓글 영역이 나온다.
# giscus.app에서 값을 받고, 저장소에 Discussions를 켠 뒤 giscus 앱을 설치해야 한다.
# NEXT_PUBLIC_* 은 빌드 때 박히므로 값을 넣은 뒤 다시 배포할 것.
NEXT_PUBLIC_GISCUS_REPO="beenchangseo/beenslab-blog"
NEXT_PUBLIC_GISCUS_REPO_ID=""
NEXT_PUBLIC_GISCUS_CATEGORY="Announcements"
NEXT_PUBLIC_GISCUS_CATEGORY_ID=""
